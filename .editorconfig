# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = false

# JavaScript & TypeScript
[*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}]
indent_style = space
indent_size = 2
insert_final_newline = true
quote_type = double

# JSON: 2-space indent is the de-facto community standard.
[*.{json,jsonc}]
indent_style = space
indent_size = 2
insert_final_newline = true

# YAML: 2-space indent.
[*.{yml,yaml}]
indent_style = space
indent_size = 2
insert_final_newline = true
